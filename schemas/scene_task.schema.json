{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/vla-franka/scene_task.schema.json",
  "title": "VLA Franka Scene and Task Definition",
  "description": "Version 1.0 interchange contract for scene metadata and language-task generation.",
  "type": "object",
  "required": ["schema_version", "scene_id", "task_id", "scene", "task"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scene_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "scene": {
      "type": "object",
      "required": ["frame_id", "objects"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/object"}
        },
        "relationships": {
          "type": "array",
          "items": {"$ref": "#/$defs/relationship"}
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["goal", "steps"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "safety_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "success_conditions": {"type": "array", "items": {"$ref": "#/$defs/successCondition"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "object": {
      "type": "object",
      "required": ["id", "label", "pose"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string", "minLength": 1},
        "category": {"type": "string"},
        "affordances": {"type": "array", "items": {"type": "string"}},
        "state": {"type": "object", "additionalProperties": true},
        "pose": {"$ref": "#/$defs/pose"}
      },
      "additionalProperties": false
    },
    "pose": {
      "type": "object",
      "required": ["position"],
      "properties": {
        "position": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}
          },
          "additionalProperties": false
        },
        "orientation_xyzw": {
          "type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["subject_id", "relation", "object_id"],
      "properties": {
        "subject_id": {"type": "string"},
        "relation": {"enum": ["on", "in", "next_to", "left_of", "right_of", "behind", "in_front_of"]},
        "object_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"enum": ["pick", "place"]},
        "object_id": {"type": "string"},
        "target_id": {"type": "string"},
        "relation": {"enum": ["on", "in", "next_to", "left_of", "right_of", "behind", "in_front_of"]},
        "instruction": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "successCondition": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "object_id": {"type": "string"},
        "target_id": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
